---
import type { SlideDefinicao } from '../../data/slides';
import Titulo from '../Titulo.astro';

interface Props {
  slide: SlideDefinicao;
}

const { slide } = Astro.props;
---

<div class="flex-1 min-h-0 flex flex-col justify-center">
  <Titulo texto={slide.titulo} tamanho={88} />
  <p class="mt-[44px] mb-0 max-w-[1500px] text-[36px] leading-[1.5] tracking-[-0.005em] text-secundario" data-texto>{slide.texto}</p>
</div>
