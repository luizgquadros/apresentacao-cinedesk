---
import type { SlideLista } from '../../data/slides';
import Titulo from '../Titulo.astro';

interface Props {
  slide: SlideLista;
}

const { slide } = Astro.props;
---

<div class="flex-1 min-h-0 flex flex-col">
  <Titulo texto={slide.titulo} />
  <ul class="my-auto m-0 p-0 list-none rounded-[28px] bg-superficie px-[44px]">
    {
      slide.itens.map((item, i) => (
        <li
          class:list={[
            'py-[22px] text-[38px] leading-[1.2] font-medium tracking-[-0.015em] text-texto whitespace-nowrap',
            { 'border-t border-separador': i > 0 },
          ]}
        >
          {item}
        </li>
      ))
    }
  </ul>
</div>
