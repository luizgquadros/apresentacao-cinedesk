---
// Gráfico em rosca (donut) feito à mão em SVG. Recebe o percentual da fatia em destaque
// (PERCENTUAL_CONCLUIDO no slide 24, PERCENTUAL_IA no slide 28); o restante é calculado.
// Quando o restante é 0%, a segunda legenda não aparece.

interface Props {
  percentual: number;
  rotuloConcluido: string;
  rotuloNaoConcluido: string;
  tamanho?: number;
}

const { percentual, rotuloConcluido, rotuloNaoConcluido, tamanho = 320 } = Astro.props;

const concluido = Math.min(100, Math.max(0, percentual));
const naoConcluido = 100 - concluido;

const espessura = Math.round(tamanho / 10);
const r = (tamanho - espessura) / 2;
const circunferencia = 2 * Math.PI * r;
const arcoConcluido = (concluido / 100) * circunferencia;
---

<div class="flex flex-col items-start gap-[44px]">
  <svg
    width={tamanho}
    height={tamanho}
    viewBox={`0 0 ${tamanho} ${tamanho}`}
    role="img"
    aria-label={`${rotuloConcluido} ${concluido}%, ${rotuloNaoConcluido} ${naoConcluido}%`}
  >
    <circle cx={tamanho / 2} cy={tamanho / 2} r={r} fill="none" stroke="var(--color-trilha)" stroke-width={espessura} />
    {
      concluido > 0 && (
        <circle
          cx={tamanho / 2}
          cy={tamanho / 2}
          r={r}
          fill="none"
          stroke="var(--color-destaque)"
          stroke-width={espessura}
          stroke-linecap={concluido < 100 ? 'round' : 'butt'}
          stroke-dasharray={`${arcoConcluido} ${circunferencia}`}
          transform={`rotate(-90 ${tamanho / 2} ${tamanho / 2})`}
        />
      )
    }
  </svg>
  <dl class="m-0 flex gap-[32px]">
    <div class="flex items-start gap-[14px]">
      <span class="mt-[9px] w-[16px] h-[16px] rounded-full bg-destaque flex-none" aria-hidden="true"></span>
      <div>
        <dt class="text-[22px] text-secundario">{rotuloConcluido}</dt>
        <dd class="m-0 mt-[4px] text-[80px] font-semibold leading-[1] tracking-[-0.035em] text-texto tabular-nums">{concluido}%</dd>
      </div>
    </div>
    {naoConcluido > 0 && (
    <div class="flex items-start gap-[14px]">
      <span class="mt-[9px] w-[16px] h-[16px] rounded-full bg-trilha border border-separador flex-none" aria-hidden="true"></span>
      <div>
        <dt class="text-[22px] text-secundario">{rotuloNaoConcluido}</dt>
        <dd class="m-0 mt-[4px] text-[80px] font-semibold leading-[1] tracking-[-0.035em] text-secundario tabular-nums">{naoConcluido}%</dd>
      </div>
    </div>
    )}
  </dl>
</div>
